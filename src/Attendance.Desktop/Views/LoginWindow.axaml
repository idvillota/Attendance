<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Attendance.Desktop.ViewModels"
        x:Class="Attendance.Desktop.Views.LoginWindow"
        x:DataType="vm:LoginViewModel"
        Title="Host Asistencia"
        Width="440"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="#F2F4F7">
    <Window.KeyBindings>
        <KeyBinding Gesture="Enter" Command="{Binding SubmitCommand}"/>
    </Window.KeyBindings>
    <Border Classes="card" Margin="28">
        <StackPanel Spacing="12">
            <TextBlock Text="Host Asistencia" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Title}" Classes="h1"/>
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Hint}"/>
            <TextBox Watermark="Usuario" Text="{Binding Username}"/>
            <TextBox Watermark="Contraseña" PasswordChar="•" Text="{Binding Password}"/>
            <TextBox Watermark="Confirmar contraseña"
                     PasswordChar="•"
                     Text="{Binding ConfirmPassword}"
                     IsVisible="{Binding NeedsSetup}"/>
            <TextBlock Text="{Binding Error}" Foreground="#B42318" TextWrapping="Wrap"/>
            <Button Content="Entrar"
                    Classes="accent"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Command="{Binding SubmitCommand}"/>
        </StackPanel>
    </Border>
</Window>
