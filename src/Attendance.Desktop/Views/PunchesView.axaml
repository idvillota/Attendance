<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Attendance.Desktop.ViewModels"
             xmlns:domain="using:Attendance.Core.Domain"
             x:Class="Attendance.Desktop.Views.PunchesView"
             x:DataType="vm:PunchesViewModel">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="16">
        <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding IntroText}"/>

        <Border Grid.Row="1" Classes="card" IsVisible="{Binding CanEditPunches}">
            <StackPanel Spacing="10">
                <TextBlock Text="Agregar corrección" FontWeight="SemiBold"/>
                <WrapPanel>
                    <ComboBox MinWidth="200"
                              Margin="0,0,12,8"
                              VerticalAlignment="Center"
                              ItemsSource="{Binding Employees}"
                              SelectedItem="{Binding SelectedEmployee}"
                              PlaceholderText="Persona">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="domain:Employee">
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <DatePicker MinWidth="280"
                                Margin="0,0,12,8"
                                VerticalAlignment="Center"
                                SelectedDate="{Binding PunchedAt}"/>
                    <ComboBox MinWidth="140"
                              Width="160"
                              Margin="0,0,12,8"
                              VerticalAlignment="Center"
                              ItemsSource="{Binding Directions}"
                              SelectedItem="{Binding Direction}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:DirectionChoice">
                                <TextBlock Text="{Binding Label}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Margin="0,0,12,8"
                            VerticalAlignment="Center"
                            Content="Agregar"
                            Classes="accent"
                            Command="{Binding AddCommand}"/>
                    <Button Margin="0,0,12,8"
                            VerticalAlignment="Center"
                            Content="Eliminar seleccionada"
                            Command="{Binding DeleteCommand}"/>
                </WrapPanel>
                <TextBlock Text="{Binding Status}" Classes="muted"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Classes="card" Padding="0">
            <DataGrid ItemsSource="{Binding Punches}"
                      SelectedItem="{Binding Selected}"
                      IsReadOnly="True"
                      AutoGenerateColumns="False"
                      CanUserResizeColumns="True"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      Background="Transparent">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Persona" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="domain:Punch">
                                <TextBlock Text="{Binding EmployeeName}" VerticalAlignment="Center" Margin="16,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Fecha y hora" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="domain:Punch">
                                <TextBlock Text="{Binding PunchedAt, StringFormat=g}" VerticalAlignment="Center" Margin="8,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Tipo" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="domain:Punch">
                                <TextBlock Text="{Binding DirectionLabel}" VerticalAlignment="Center" Margin="8,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Origen" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="domain:Punch">
                                <TextBlock Text="{Binding SourceLabel}" VerticalAlignment="Center" Margin="8,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
