<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Attendance.Desktop.ViewModels"
             x:Class="Attendance.Desktop.Views.DeviceView"
             x:DataType="vm:DeviceViewModel">
    <StackPanel MaxWidth="720" Spacing="16">
        <Border Classes="card">
            <StackPanel Spacing="12">
                <TextBlock Text="Conexión al reloj" FontWeight="SemiBold" FontSize="16"/>
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="Las personas marcan con la huella en el K30. Descargar ahora lee el reloj y abre Logs K30 para revisar; no guarda en nómina hasta que confirme. El CSV sí se importa de inmediato."/>
                <TextBox Watermark="IP del K30" Text="{Binding DeviceIp}"/>
                <TextBox Watermark="Puerto (4370)" Text="{Binding DevicePort}"/>
                <WrapPanel>
                    <Button Margin="0,0,8,8" Content="Guardar" Command="{Binding SaveCommand}"/>
                    <Button Margin="0,0,8,8" Content="Probar conexión" Command="{Binding TestCommand}"/>
                    <Button Margin="0,0,8,8" Content="Descargar ahora" Classes="accent" Command="{Binding DownloadCommand}"/>
                    <Button Margin="0,0,8,8" Content="Importar CSV" Click="ImportCsvClick"/>
                </WrapPanel>
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <Border Classes="card">
            <StackPanel Spacing="8">
                <TextBlock Text="Respaldo" FontWeight="SemiBold"/>
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="{Binding DatabasePath, StringFormat='Copie este archivo para no perder la nómina: {0}'}"/>
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="CSV de respaldo: DeviceUserId,FechaHora,Entrada|Salida"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
