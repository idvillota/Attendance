<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Attendance.Desktop.ViewModels"
        xmlns:views="using:Attendance.Desktop.Views"
        x:Class="Attendance.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Host Asistencia"
        Width="1280"
        Height="720"
        MinWidth="1024"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#F2F4F7">
    <Window.DataTemplates>
        <DataTemplate DataType="vm:EmployeesViewModel">
            <views:EmployeesView />
        </DataTemplate>
        <DataTemplate DataType="vm:RolesViewModel">
            <views:RolesView />
        </DataTemplate>
        <DataTemplate DataType="vm:PunchesViewModel">
            <views:PunchesView />
        </DataTemplate>
        <DataTemplate DataType="vm:ReportViewModel">
            <views:ReportView />
        </DataTemplate>
        <DataTemplate DataType="vm:DeviceViewModel">
            <views:DeviceView />
        </DataTemplate>
        <DataTemplate DataType="vm:DeviceLogsViewModel">
            <views:DeviceLogsView />
        </DataTemplate>
        <DataTemplate DataType="vm:ScheduleViewModel">
            <views:ScheduleView />
        </DataTemplate>
        <DataTemplate DataType="vm:UsersViewModel">
            <views:UsersView />
        </DataTemplate>
    </Window.DataTemplates>

    <Grid ColumnDefinitions="220,*">
        <Border Background="#0F172A" Padding="16,20">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="8,0,8,20">
                    <TextBlock Text="Host Asistencia" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Text="Nómina semanal · K30" Foreground="#94A3B8" FontSize="12"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="8,16,8,0">
                    <TextBlock Text="{Binding UserLabel}" Foreground="White" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding RoleLabel}" Foreground="#94A3B8" FontSize="12"/>
                    <Button Content="Cerrar sesión"
                            Command="{Binding LogoutCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Background="#334155"
                            Foreground="#F8FAFC"/>
                </StackPanel>
                <ListBox Classes="nav"
                         ItemsSource="{Binding NavItems}"
                         SelectedIndex="{Binding NavIndex}"/>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="Auto,*">
            <Border Padding="20,16,20,8">
                <TextBlock Text="{Binding CurrentSection}" Classes="h1"/>
            </Border>
            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" Margin="20,4,20,20"/>
        </Grid>
    </Grid>
</Window>
