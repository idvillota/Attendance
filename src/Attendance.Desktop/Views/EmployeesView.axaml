<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Attendance.Desktop.ViewModels"
             x:Class="Attendance.Desktop.Views.EmployeesView"
             x:DataType="vm:EmployeesViewModel">
    <Grid RowDefinitions="Auto,*" RowSpacing="16">
        <DockPanel>
            <Button DockPanel.Dock="Right"
                    Content="Nueva persona"
                    Classes="accent"
                    Click="AddClick"
                    VerticalAlignment="Top"
                    IsVisible="{Binding CanManagePeople}"/>
            <StackPanel Spacing="8" Margin="0,0,16,0">
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="Directorio del restaurante. Al agregar o editar se guarda aquí y se crea o actualiza el mismo PIN en el K30 (clave temporal; la huella se registra en el reloj)."/>
                <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Freshness}"/>
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="10" Height="10" Fill="#98A2B3"/>
                        <TextBlock Classes="muted" Text="Inactivo" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="10" Height="10" Fill="#F5A524"/>
                        <TextBlock Classes="muted" Text="Fuera" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="10" Height="10" Fill="#12B76A"/>
                        <TextBlock Classes="muted" Text="En turno" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Classes="card" Padding="8,4">
            <ListBox ItemsSource="{Binding Employees}"
                     Background="Transparent"
                     BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:EmployeePresenceItem">
                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="8,10">
                            <Ellipse Width="14" Height="14"
                                     Fill="{Binding Fill}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,12,0"
                                     ToolTip.Tip="{Binding PresenceLabel}"/>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Subtitle}" Classes="muted"/>
                                <TextBlock Text="{Binding PresenceLabel}" FontSize="12" Foreground="#475467"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Content="Editar"
                                        Classes="ghost"
                                        Click="EditClick"
                                        IsVisible="{Binding CanEdit}"/>
                                <Button Content="Eliminar"
                                        Classes="ghost"
                                        Click="DeleteClick"
                                        IsVisible="{Binding CanEdit}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
